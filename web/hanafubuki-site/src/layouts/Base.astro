---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/lora/wght.css';
import '../styles/global.css';
import config from '../config.json';

interface Props {
  t: any;
  title?: string;
  noindex?: boolean;
}
const { t, title = t.meta.title, noindex = false } = Astro.props;
const url = new URL(Astro.url.pathname, config.site.url).href;
const og = new URL('/og-banner.png', config.site.url).href;
---
<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="theme-color" content="#1B1530" />
    <meta name="color-scheme" content="dark" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={url} />}
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hanafubuki" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={t.meta.ogAlt} />
  </head>
  <body>
    <slot />
  </body>
</html>
